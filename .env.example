# KarmaTute Full-Stack Environment Variables Template
# NEVER COMMIT ACTUAL SECRETS OR PASSWORDS TO SOURCE CONTROL.

# Backend Spring Boot Configuration
PORT=8080
DATABASE_DRIVER=org.postgresql.Driver
DATABASE_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=YOUR_SUPABASE_PASSWORD_HERE
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=2
SPRING_JPA_DDL_AUTO=update

# Optional AI Key (Deterministic engine will act as fallback if not set)
MISTRAL_API_KEY=YOUR_MISTRAL_API_KEY_HERE

# Allowed CORS origins (Comma-separated URLs)
FRONTEND_ORIGIN=https://karmavaani-frontend.onrender.com

# Frontend Vite Configuration
VITE_API_BASE_URL=https://karmatute-backend.onrender.com
